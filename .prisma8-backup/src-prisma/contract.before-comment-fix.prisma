  SHIPPING
  BILLING
  OTHER
}


/**
 * ============================================================================
 * ENUMS — COMMANDES
 * ============================================================================
 */

enum OrderStatus {
  @@type("pg/text@1")

  PENDING
  CONFIRMED
  PROCESSING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
