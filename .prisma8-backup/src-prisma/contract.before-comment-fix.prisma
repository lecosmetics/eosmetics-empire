// use prisma-8


/**
 * ============================================================================
 * L&E COSMETICS EMPIRE — DATA CONTRACT PRINCIPAL
 * ============================================================================
 *
 * Projet :
 * Cosmetics Empire
 *
 * Base :
 * PostgreSQL / Supabase
 *
 * ORM :
 * Prisma ORM 8
 *
 * Architecture :
 *
 * - Boutiques / points de vente / représentants
 * - Gestionnaires et authentification
 * - Inscription Gestionnaire sécurisée
 * - Vérification OTP par e-mail
 * - Catalogue officiel L&E
 * - Produits créés par les boutiques
 * - Produits commercialisés par boutique
 * - Images produit
 * - Prix normal / promotionnel
 * - QR code stable
 * - Stock
 * - Historique des mouvements de stock
 * - Clients
 * - Adresses
 * - Commandes
 * - Paiements
 * - Livraisons
 * - Reçus
 * - Notifications
 * - Historique des e-mails
 * - Rate limiting de sécurité
 * - Journal d'audit
 *
 * IMPORTANT :
 *
 * Prisma ORM 8 n'utilise plus ici :
 *
 * - generator client
 * - datasource db
 *
 * La connexion PostgreSQL est définie dans :
 *
 * prisma.config.ts
 *
 * ============================================================================
 */


/**
 * ============================================================================
 * ENUMS — BOUTIQUES
 * ============================================================================
 */

enum StoreType {
  @@type("pg/text@1")

  BOUTIQUE
  POINT_OF_SALE
  REPRESENTATIVE
}


enum StoreStatus {
  @@type("pg/text@1")

  ACTIVE
  SUSPENDED
  DISABLED
}


/**
 * ============================================================================
 * ENUMS — GESTIONNAIRES
 * ============================================================================
 */

enum ManagerRole {
  @@type("pg/text@1")

  OWNER
  MANAGER
  STAFF
}


enum ManagerStatus {
  @@type("pg/text@1")

  ACTIVE
  SUSPENDED
  DISABLED
}


/**
 * ============================================================================
 * ENUMS — INSCRIPTION
 * ============================================================================
 */

enum RegistrationStatus {
  @@type("pg/text@1")

  PENDING_VERIFICATION
  EMAIL_VERIFIED
  COMPLETED
  EXPIRED
  CANCELLED
}


/**
 * ============================================================================
 * ENUMS — PRODUITS
 * ============================================================================
 */

enum ProductOrigin {
  @@type("pg/text@1")

  CATALOG
  STORE
}


enum ProductStatus {
  @@type("pg/text@1")

  DRAFT
  ACTIVE
  ARCHIVED
}


enum StoreProductStatus {
  @@type("pg/text@1")

  ACTIVE
  OUT_OF_STOCK
  HIDDEN
  ARCHIVED
}


enum StockMovementType {
  @@type("pg/text@1")

  INITIAL
  RESTOCK
  SALE
  RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  CANCELLATION
}


/**
 * ============================================================================
 * ENUMS — CLIENTS
 * ============================================================================
 */

enum CustomerStatus {
