/**
 * ============================================================================
 * ENUMS — NOTIFICATIONS
 * ============================================================================
 */

enum NotificationType {
  @@type("pg/text@1")

  ORDER
  PAYMENT
  STOCK
  DELIVERY
  SECURITY
  SYSTEM
}


enum NotificationChannel {
  @@type("pg/text@1")

  IN_APP
  EMAIL
}


enum NotificationStatus {
  @@type("pg/text@1")

  PENDING
