/**
 * ============================================================================
 * PRODUIT
 * ============================================================================
 * Product reprÃ©sente l'identitÃ© mÃ©tier du produit.
 * CATALOG :
 * - produit officiel du catalogue L&E ;
 * - createdByStoreId reste null.
 * STORE :
 * - produit crÃ©Ã© directement par une boutique ;
 * - createdByStoreId contient la boutique crÃ©atrice.
 * IMPORTANT :
 * Product ne conserve PAS :
 * - le prix commercial ;
 * - la devise commerciale ;
 * - le stock ;
 * - le QR public.
 * Ces donnÃ©es appartiennent Ã  StoreProduct.
 * ============================================================================
 */

model Product {
  id String @id @default(cuid())

  /**
   * CATALOG reste la valeur par dÃ©faut pour conserver la compatibilitÃ©
   * avec les donnÃ©es historiques.
   * L'action Gestionnaire /produits/ajouter dÃ©finira explicitement STORE.
