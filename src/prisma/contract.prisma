/**
 * ============================================================================
 * BOUTIQUE
 * ============================================================================
 */

model Store {
  id String @id @default(cuid())

  name String

  slug String @unique

  type StoreType @default(BOUTIQUE)

  city String

  country String

  address String

  phone String

  email String

  /**
   * Devise principale du point de vente.
   * Exemple :
   * Cameroun :
   * XAF
   * BÃ©nin :
   * XOF
   * Europe :
   * EUR
   * Ã‰tats-Unis :
   * USD
   * Le formulaire Ajouter un produit NE doit donc pas forcer
   * directement "FCFA".
   * Lors de la crÃ©ation d'un StoreProduct, cette valeur sera copiÃ©e
   * dans StoreProduct.currency.
   * XAF reste la valeur par dÃ©faut uniquement pour compatibilitÃ©.
   */
  currency String @default("XAF")

  status StoreStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

