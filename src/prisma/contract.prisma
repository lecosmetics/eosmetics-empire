/**
 * ============================================================================
 * PRODUIT COMMERCIALISÃ‰ PAR UNE BOUTIQUE
 * ============================================================================
 * StoreProduct contient les informations spÃ©cifiques Ã  la boutique :
 * - prix ;
 * - Ã©ventuel prix barrÃ© / de rÃ©fÃ©rence ;
 * - devise ;
 * - stock ;
 * - seuil de stock faible ;
 * - statut commercial ;
 * - QR stable.
 * PRIX :
 * Sans promotion :
 * price = prix normal
 * compareAtPrice = null
 * Avec prix barrÃ© :
 * price = prix actuellement payÃ©
 * compareAtPrice = ancien prix / prix de rÃ©fÃ©rence
 * et :
 * compareAtPrice > price
 * lorsque compareAtPrice est utilisÃ© comme prix barrÃ©.
 * QR :
 * qrToken reprÃ©sente l'identitÃ© publique stable de CE StoreProduct.
 * Une modification du :
 * - prix ;
 * - stock ;
 * - nom ;
 * - description ;
 * - image ;
 * NE modifie jamais qrToken.
 * ============================================================================
 */

model StoreProduct {
  id String @id @default(cuid())

  storeId String

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  /**
   * Prix actuellement appliquÃ©.
   */
  price Decimal @db.Decimal(12, 2)

  /**
   * Prix de rÃ©fÃ©rence / ancien prix.
   * Null lorsqu'aucun prix barrÃ© n'est appliquÃ©.
   */
  compareAtPrice Decimal? @db.Decimal(12, 2)

  /**
   * Code devise.
   * Lors de la crÃ©ation via l'espace Gestionnaire, le backend utilisera
   * normalement Store.currency.
   * XAF reste un fallback de compatibilitÃ© DB.
   */
  currency String @default("XAF")

  /**
   * Stock courant.
   * L'historique de ses modifications est conservÃ© dans StockMovement.
   */
  stockQuantity Int @default(0)

  lowStockThreshold Int @default(5)

  status StoreProductStatus @default(ACTIVE)

  /**
   * Token public :
   * - unique ;
   * - stable ;
   * - non sensible ;
   * - gÃ©nÃ©rÃ© cÃ´tÃ© serveur ;
   * - jamais construit Ã  partir du prix ou du stock.
   * Exemple de destination :
   * https://domaine.com/p/{qrToken}
   * Le QR physique encode uniquement cette URL publique.
   */
  qrToken String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]

  stockMovements StockMovement[]

  @@unique([storeId, productId])
  @@index([storeId, status])
  @@index([productId])
  @@index([stockQuantity])
  @@map("store_products")
}

/**
 * ============================================================================
 * MOUVEMENTS DE STOCK
 * ============================================================================
 * StoreProduct.stockQuantity :
 * stock actuellement disponible.
 * StockMovement :
 * historique immuable des variations de stock.
 * Lors de la crÃ©ation d'un produit avec :
 * Stock disponible = 50
 * le backend pourra crÃ©er :
 * type           = INITIAL
 * quantity       = 50
 * quantityBefore = 0
 * quantityAfter  = 50
 * dans la mÃªme transaction DB que la crÃ©ation commerciale du produit.
 * ============================================================================
 */

model StockMovement {
  id String @id @default(cuid())

  storeId String

  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)

  storeProductId String

  storeProduct StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Restrict)

  managerId String?

  manager Manager? @relation(fields: [managerId], references: [id], onDelete: SetNull)

  type StockMovementType

  /**
   * QuantitÃ© de mouvement.
   * Le sens mÃ©tier dÃ©pend de type.
   */
  quantity Int

  quantityBefore Int

  quantityAfter Int

  reason String?

  reference String?

  createdAt DateTime @default(now())

  @@index([storeId])
  @@index([storeProductId])
  @@index([managerId])
  @@index([createdAt])
  @@map("stock_movements")
}

